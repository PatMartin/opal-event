# OPAL dotenv example.
# Startup reads ./.env by default; real environment variables always win,
# including empty strings. Use --env-file PATH for another file, or
# --no-env-file to disable loading and initialization. Secret values stay
# local; this example is safe to commit.

# OPAL_EVENT_CONFIG
#OPAL_EVENT_CONFIG=config/opal_event.yaml

# OPAL_EVENT_HOST
#OPAL_EVENT_HOST=127.0.0.1

# OPAL_EVENT_PORT
#OPAL_EVENT_PORT=8080

# OPAL_EVENT_ZMQ_PUBLISHERS
#OPAL_EVENT_ZMQ_PUBLISHERS=tcp://127.0.0.1:5555

# OPAL_EVENT_ZMQ_SUBSCRIBERS
#OPAL_EVENT_ZMQ_SUBSCRIBERS=tcp://127.0.0.1:5556

# OPAL_EVENT_DATABASE
#OPAL_EVENT_DATABASE=var/opal_event.db

# OPAL_EVENT_API_TOKEN
#OPAL_EVENT_API_TOKEN=<optional-bearer-token>

